# Copiez ce fichier en .env.local et renseignez votre clé.
# Clé API Anthropic — requise UNIQUEMENT pour le mode agent réel (npm run agent).
# Le mode déterministe (npm run demo) fonctionne SANS clé.
ANTHROPIC_API_KEY=

# Modèle de la boucle agentique (défaut Haiku si non renseigné).
ANTHROPIC_MODEL=claude-haiku-4-5
